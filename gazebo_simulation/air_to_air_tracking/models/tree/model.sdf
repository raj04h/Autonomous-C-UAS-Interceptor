<?xml version="1.0"?>

<sdf version="1.9">

  <model name="tree">

    <static>true</static>

    <!-- Trunk                                              -->

    <link name="trunk">

      <pose>0 0 2.0 0 0 0</pose>

      <visual name="trunk_visual">

        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.20 0.10 0.04 1</ambient>
          <diffuse>0.30 0.15 0.05 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>

      </visual>

    </link>


    <!-- Lower Foliage                                      -->

    <link name="lower_foliage">

      <pose>0 0 5.0 0 0 0</pose>

      <visual name="lower_foliage_visual">

        <geometry>
          <sphere>
            <radius>2.3</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.04 0.20 0.04 1</ambient>
          <diffuse>0.06 0.32 0.06 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>

      </visual>

    </link>


    <!-- Upper Foliage                                      -->

    <link name="upper_foliage">

      <pose>0 0 7.0 0 0 0</pose>

      <visual name="upper_foliage_visual">

        <geometry>
          <sphere>
            <radius>1.8</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.03 0.16 0.03 1</ambient>
          <diffuse>0.04 0.27 0.04 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>

      </visual>

    </link>

  </model>

</sdf>